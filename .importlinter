[importlinter]
root_packages =
    supportagent
include_external_packages = True

# Six contracts from 01-architecture-and-contracts §2 (frozen), plus
# adapters-no-app, which closes the gap the diagram in the same section
# already shows (adapters point only at ports), and llm-providers-private
# (10-wp WP-007 DoD).
# Run with: lint-imports
#
# import-linter only expresses blocklists, so the spec's allowlist rules
# ("imports only X and Y") are enforced by forbidding *every* other known
# third-party package. The third-party set is the 05 §1 runtime dependency
# list; adding a runtime dependency without an ADR is already a spec
# violation, so the allowlist stays closed by construction.

[importlinter:contract:domain-pure]
name = domain-pure
type = forbidden
# 01 §2: domain imports only stdlib, pydantic, typing_extensions and itself.
source_modules =
    supportagent.domain
forbidden_modules =
    fastapi
    uvicorn
    jinja2
    pydantic_settings
    sqlalchemy
    alembic
    psycopg
    httpx
    typer
    structlog
    cryptography
    ulid
    authlib
    celpy
    anthropic
    openai
    # ADR-0004: YAML parsing lives at the config/adapters boundary only.
    yaml

[importlinter:contract:ports-protocol-only]
name = ports-protocol-only
type = forbidden
# Direct imports only: ports import domain, and domain may use pydantic
# (domain-pure), so a ports -> domain -> pydantic chain is legitimate.
allow_indirect_imports = True
# 01 §2: ports imports only domain and typing — not even pydantic.
source_modules =
    supportagent.ports
forbidden_modules =
    supportagent.adapters
    supportagent.app
    supportagent.config
    supportagent.evals
    supportagent.entrypoints
    supportagent.bootstrap
    fastapi
    uvicorn
    jinja2
    pydantic
    pydantic_settings
    sqlalchemy
    alembic
    psycopg
    httpx
    typer
    structlog
    cryptography
    ulid
    authlib
    celpy
    anthropic
    openai
    # ADR-0004: YAML parsing lives at the config/adapters boundary only.
    yaml

[importlinter:contract:app-no-adapters]
name = app-no-adapters
type = forbidden
source_modules =
    supportagent.app
forbidden_modules =
    supportagent.adapters
    supportagent.entrypoints
    supportagent.bootstrap

[importlinter:contract:adapters-independent]
name = adapters-independent
type = independence
modules =
    supportagent.adapters.db
    supportagent.adapters.crypto
    supportagent.adapters.system
    supportagent.adapters.files
    supportagent.adapters.llm
    supportagent.adapters.servicenow
    supportagent.adapters.identity
    supportagent.adapters.resilience
    supportagent.adapters.tools
    supportagent.adapters.cel
    supportagent.adapters.paging
    supportagent.adapters.webhook
    supportagent.adapters.fakes

[importlinter:contract:adapters-no-app]
name = adapters-no-app
type = forbidden
# 01 §2 diagram: adapters point only at ports — never back at app,
# entrypoints or bootstrap (shared code goes to domain or ports).
source_modules =
    supportagent.adapters
forbidden_modules =
    supportagent.app
    supportagent.entrypoints
    supportagent.bootstrap

[importlinter:contract:only-bootstrap-wires]
name = only-bootstrap-wires
type = forbidden
source_modules =
    supportagent.domain
    supportagent.ports
    supportagent.app
    supportagent.config
    supportagent.evals
forbidden_modules =
    supportagent.adapters

[importlinter:contract:entrypoints-thin]
name = entrypoints-thin
type = forbidden
# Direct imports only: entrypoints call bootstrap, which wires the SQL/HTTP
# adapters, so entrypoints -> bootstrap -> adapters -> sqlalchemy is the
# intended shape. The rule is that entrypoints never run SQL/HTTP themselves.
allow_indirect_imports = True
source_modules =
    supportagent.entrypoints
forbidden_modules =
    sqlalchemy
    httpx

[importlinter:contract:llm-providers-private]
name = llm-providers-private
type = forbidden
# 10-wp WP-007 DoD / INV-06: no module outside adapters/llm imports provider
# classes, so the only path to a provider is LLMClient (render -> redact ->
# call). Bootstrap wires through adapters.llm.client.build_llm_client, so the
# *direct* import of providers is banned but the intended indirect path
# bootstrap -> client -> providers is allowed (allow_indirect_imports).
# Other adapters are already covered by adapters-independent.
allow_indirect_imports = true
source_modules =
    supportagent.domain
    supportagent.ports
    supportagent.app
    supportagent.config
    supportagent.evals
    supportagent.entrypoints
    supportagent.bootstrap
forbidden_modules =
    supportagent.adapters.llm.providers
