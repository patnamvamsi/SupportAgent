{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://supportagent.dev/schemas/runbook.schema.json",
  "title": "SupportAgent runbook (ARCH §5.1)",
  "type": "object",
  "required": ["id", "applies_when", "steps"],
  "additionalProperties": false,
  "properties": {
    "id": {"type": "string", "pattern": "^runbook:[a-z0-9-]{1,48}$"},
    "applies_when": {
      "type": "object",
      "required": ["classification"],
      "additionalProperties": false,
      "properties": {
        "classification": {"type": "string"},
        "severities": {"type": "array", "items": {"enum": ["P1", "P2", "P3", "P4"]}}
      }
    },
    "budget": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "max_tool_calls": {"type": "integer", "minimum": 1, "maximum": 25},
        "max_tokens": {"type": "integer", "minimum": 0},
        "max_hypotheses": {"type": "integer", "minimum": 1, "maximum": 10}
      }
    },
    "steps": {
      "type": "array",
      "minItems": 1,
      "maxItems": 25,
      "items": {
        "type": "object",
        "required": ["id", "hypothesis", "tool", "check"],
        "additionalProperties": false,
        "properties": {
          "id": {"type": "string", "pattern": "^[a-z0-9_-]{1,32}$"},
          "hypothesis": {"type": "string"},
          "tool": {"type": "string"},
          "args": {"type": "object", "additionalProperties": {"type": ["string", "integer"]}},
          "check": {"type": "string", "description": "CEL over result, service, case"},
          "stop_if": {"type": "boolean"}
        }
      }
    },
    "comms_if_supported": {
      "type": "object",
      "required": ["audience", "template"],
      "additionalProperties": false,
      "properties": {
        "audience": {"type": "array", "items": {"const": "internal"}, "minItems": 1, "maxItems": 1},
        "template": {"type": "string"}
      }
    }
  }
}
