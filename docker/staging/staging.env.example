# Copy to .env (cp staging.env.example .env) on the staging host and fill in
# (chmod 600). Never commit .env. Single-quote any value with special
# characters: compose then reads it literally.
POSTGRES_PASSWORD=
SA_MASTER_KEY=              # python3 -c "import secrets; print(secrets.token_hex(32))"
SA_SESSION_SECRET=          # python3 -c "import secrets; print(secrets.token_urlsafe(48))"
KEYCLOAK_ADMIN_USER=kcadmin
KEYCLOAK_ADMIN_PASSWORD=
OIDC_CLIENT_ID=supportagent
OIDC_CLIENT_SECRET=         # written by keycloak-setup.sh
STAGING_USER_PASSWORD=      # the password keycloak-setup.sh gives ada and bob
SN_USER=svc_supportagent
SN_PASSWORD=
