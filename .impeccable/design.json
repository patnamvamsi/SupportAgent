      "html": "<span class=\"ds-badge ds-ok\">confirmed</span> <span class=\"ds-badge ds-proposed\">proposed</span> <span class=\"ds-badge ds-rejected\">rejected</span> <span class=\"ds-sev ds-p1\">P1</span>",
      "css": ".ds-badge{display:inline-flex;align-items:center;font-family: \"Public Sans\", system-ui, sans-serif;font-size:.8rem;font-weight:600;line-height:1.5;padding:.05rem .55rem;border-radius:999px;border:1px solid var(--line-2);color:var(--ink-2);background:var(--panel)}.ds-ok{border-color:var(--ok);color:var(--ok)}.ds-proposed{border-style:dashed;border-color:var(--warn);color:var(--warn);background:transparent}.ds-rejected{color:var(--muted);text-decoration:line-through}.ds-sev{display:inline-block;min-width:2.1rem;text-align:center;font:700 .78rem/1.6 ui-monospace,Menlo,monospace;border-radius:4px;padding:0 .35rem;border:1px solid var(--line-2)}.ds-p1{background:var(--seal);border-color:var(--seal);color:var(--seal-ink)}"
