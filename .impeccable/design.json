      "css": ".ds-btn-primary{font-family: \"Public Sans\", system-ui, sans-serif;font-size:.92rem;font-weight:600;padding:.45rem .95rem;border:1px solid var(--ink);border-radius:6px;background:var(--ink);color:var(--panel);cursor:pointer;transition:background-color .15s,transform .1s}.ds-btn-primary:hover{background:var(--ink-2)}.ds-btn-primary:active{transform:translateY(1px)}.ds-btn-primary:focus-visible{outline:2px solid var(--focus);outline-offset:2px}"
