      "html": "<nav class=\"ds-rail\"><a href=\"#\" aria-current=\"page\"><svg class=\"ds-icon\" viewBox=\"0 0 24 24\"><circle cx=\"6\" cy=\"7\" r=\"2.5\"/><circle cx=\"18\" cy=\"6\" r=\"2.5\"/><circle cx=\"12\" cy=\"17\" r=\"2.5\"/><path d=\"M8.3 8.3 10.6 15M15.8 7.4l-2.6 7.4M8.5 7h7\"/></svg>System</a><a href=\"#\"><svg class=\"ds-icon\" viewBox=\"0 0 24 24\"><circle cx=\"12\" cy=\"10\" r=\"6\"/><path d=\"m9.5 10 1.8 1.8L14.8 8.4M8.5 15 7 21l5-2.5 5 2.5-1.5-6\"/></svg>Approvals<b class=\"ds-count\">2</b></a></nav>",
      "css": ".ds-rail{display:flex;flex-direction:column;gap:2px;width:236px;padding:14px;background:var(--rail)}.ds-rail a{display:flex;align-items:center;gap:10px;padding:8px 10px;border-radius:6px;color:var(--rail-ink);text-decoration:none;font-family: \"Public Sans\", system-ui, sans-serif;font-size:.94rem}.ds-rail a:hover{background:var(--rail-2);color:#fff}.ds-rail a[aria-current=page]{background:var(--rail-2);color:#fff;font-weight:600;box-shadow:inset 0 0 0 1px #334259}.ds-rail a:focus-visible{outline:2px solid var(--focus);outline-offset:2px}.ds-icon{width:18px;height:18px;stroke:currentColor;fill:none;stroke-width:1.7;stroke-linecap:round;stroke-linejoin:round}.ds-count{margin-left:auto;font:700 11px/1.6 ui-monospace,Menlo,monospace;padding:0 6px;border-radius:4px;background:var(--seal);color:var(--seal-ink)}"
