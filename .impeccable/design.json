      "css": ".ds-tag{display:inline-block;font:700 11px/1.5 ui-monospace,Menlo,monospace;letter-spacing:.02em;color:var(--tag-ink);background:var(--tag);padding:1px 7px 1px 12px;clip-path:polygon(7px 0,100% 0,100% 100%,7px 100%,0 50%)}.ds-tag-hollow{display:inline-block;font:700 11px/1.5 ui-monospace,Menlo,monospace;color:var(--muted);box-shadow:inset 0 0 0 1px var(--line-2);padding:0 6px;border-radius:3px}"
