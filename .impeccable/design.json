      "html": "<button class=\"ds-btn\">Reset view</button>",
      "css": ".ds-btn{font-family: \"Public Sans\", system-ui, sans-serif;font-size:.92rem;font-weight:600;padding:.45rem .95rem;border:1px solid var(--line-2);border-radius:6px;background:var(--panel);color:var(--ink);cursor:pointer;transition:background-color .15s,border-color .15s,transform .1s}.ds-btn:hover{border-color:var(--ink-2)}.ds-btn:active{transform:translateY(1px)}.ds-btn:focus-visible{outline:2px solid var(--focus);outline-offset:2px}"
